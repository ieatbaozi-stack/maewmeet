{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 19 * * *"
    }
  ],
  "schedules": {
    "reminders": {
      "schedule": "*/15 * * * *",
      "timezone": "Asia/Bangkok",
      "path": "/api/cron/reminders",
      "requestMethod": "GET"
    }
  }
}
