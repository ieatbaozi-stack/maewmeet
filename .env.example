# maewmeet — แม่แบบตัวแปร env (ARCHITECTURE §7) · เจ้าของ: OPS (#10)
# ไฟล์นี้ต้อง **ไม่มีค่าลับจริง** เด็ดขาด (CLAUDE.md กฎ 7 · R0-5)
# dev บนเครื่อง: copy เป็น .env.local แล้วใส่ค่าสุ่มของตัวเอง (.env* อื่นถูก .gitignore)
# ตั้งค่าบน Vercel: ดู docs/OPERATIONS.md ส่วน D (ตาราง Type Secret/Config, Production/Preview) · สร้างความลับ: ส่วน C

# ── ฐานข้อมูล (Turso) ──────────────────────────────── ต้องมี: prod/preview
TURSO_DATABASE_URL=            # libsql://<db>-<org>.turso.io  · dev/test ใช้ file:./local.db
TURSO_AUTH_TOKEN=              # token ของ DB (ว่างได้เมื่อใช้ file:)

# ── ความลับของแอป ─────────────────────────────────── ต้องมี: ทุกสภาพแวดล้อม (dev ใช้ค่าสุ่มของตัวเอง)
PIN_PEPPER_CURRENT_VERSION=1   # เวอร์ชันที่ใช้ hash ใหม่ (ADR 0002 §7.3)
PIN_PEPPER_V1=                 # base64 ของ ≥32 ไบต์ · boss สร้างเองบนเครื่อง (PowerShell: docs/OPERATIONS.md ส่วน C)
                               # ไม่มีค่าดีฟอลต์ — หาย/ว่าง/ผิดค่า → login ปิด (AUTH_MAINTENANCE) ไม่สร้างใหม่เอง
                               # Vercel: Type Secret · ค่า production ใส่เฉพาะ Production (Preview ใช้ค่าอื่น) · สำรอง 2 ที่ตาม ADR 0002 §7.4 · ห้ามใส่ใน repo/แชท
# PIN_PEPPER_V2=               # เพิ่มตอนหมุน · ลบตัวเก่าได้เมื่อไม่มีผู้ใช้เวอร์ชันนั้นเหลือ
APP_SECRET=                    # base64 ≥32 ไบต์ · HKDF แยก subkey: invite-code HMAC, rate-limit IP HMAC
CRON_SECRET=                   # ≥16 ตัวอักษรสุ่ม · Vercel ส่งเป็น Authorization: Bearer ให้ cron อัตโนมัติ
                               # ใส่ค่าเดียวกันใน GitHub Secrets ชื่อ CRON_SECRET + APP_ORIGIN สำหรับ workflow keepalive

# ── URL / คุกกี้ ────────────────────────────────────
APP_ORIGIN=                    # เช่น https://maewmeet.vercel.app · ใช้ตรวจ Origin (CSRF) · preview ใช้ VERCEL_URL ถ้าว่าง

# ── ค้นหาสถานที่ / แผนที่ (D11) ─────────────────────────
PLACE_SEARCH_ENABLED=true      # kill switch ตาม Nominatim usage policy
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=             # อีเมล/URL ติดต่อ ใส่ใน User-Agent "maewmeet/<ver> (<contact>)"
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Proxy / IP ของผู้เรียก (rate limit) ───────────────
# แอปเชื่อ header IP (x-vercel-forwarded-for / x-real-ip / x-forwarded-for) เฉพาะเมื่อมี env VERCEL (Vercel ใส่ให้เอง) หรือ TRUST_PROXY_HEADERS=1
# ตั้ง TRUST_PROXY_HEADERS=1 เมื่ออยู่หลัง reverse proxy ที่เขียนทับ header เหล่านี้เองเท่านั้น — ไม่งั้นใครก็ปลอม IP หลบ rate limit ได้
# ไม่ตั้ง = ทุกคำขอรวมอยู่ถัง 'unknown' ถังเดียว เพดาน ×50 ของปกติ (dev ตรง ๆ ใช้ได้) — รายละเอียด docs/OPERATIONS.md
TRUST_PROXY_HEADERS=           # 1 = เชื่อ header IP จาก proxy · ว่าง = ไม่เชื่อ (Vercel ไม่ต้องตั้ง)

# ── อื่น ๆ ─────────────────────────────────────────
LOG_LEVEL=info                 # debug|info|warn|error — ห้าม log PIN/hash/token/โค้ดเชิญ ทุกระดับ
SERVER_TIMING_ENABLED=         # R7: true|false · ว่าง = เปิด (dev/preview) แต่ปิดเมื่อ VERCEL_ENV=production · header Server-Timing มีแค่จำนวน query + เวลา

# ── LINE OA แจ้งเตือนก่อนนัด (R10) ───────────────────────
# ใส่ค่าเฉพาะ Vercel **Production** (Type Secret) · Preview เว้นว่าง/ไม่ตั้ง = ช่องทาง LINE ปิดเงียบ ไม่ส่งถึงคนจริง · กระดิ่งในแอปทำงานปกติ
# ห้ามใส่ค่าจริงในไฟล์นี้/แชท/PR · ขั้นตั้งค่า: docs/OPERATIONS.md ส่วน J
LINE_MESSAGING_ACCESS_TOKEN=   # Channel access token (long-lived) · ใช้ส่ง Push/Reply
LINE_MESSAGING_CHANNEL_SECRET= # Channel secret · ใช้ตรวจ X-Line-Signature ของ webhook
# ไม่ใช้ LINE Login
